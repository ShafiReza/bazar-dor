# API Base URL
NEXT_PUBLIC_API_BASE_URL=https://api.api-store.workers.dev/api/bazardor

# Better Auth
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-chars-long-change-this
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bazardor
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/bazardor

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
